        F3["6.3 Eksekusi Penanganan Teknis Lapangan (<=14 Hari Kerja)"]
        F4["6.4 Unggah Laporan Hasil Akhir & Dokumentasi 100%"]
    end

    subgraph S7 ["7. BAPPEDA PROVINSI JAWA BARAT"]
